# Shopify app credentials. Keep real values in deployment secrets only.
SHOPIFY_API_KEY=REPLACE_WITH_SHOPIFY_CLIENT_ID
SHOPIFY_API_SECRET=REPLACE_WITH_SHOPIFY_CLIENT_SECRET
SHOPIFY_API_VERSION=2026-07
# Public backend origin used by the Shopify app configuration when the API is deployed.
SHOPIFY_APP_URL=https://windingpurplevalue.pages.dev
