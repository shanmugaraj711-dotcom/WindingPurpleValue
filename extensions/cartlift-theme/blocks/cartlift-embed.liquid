{% comment %}
  CartLift V1 storefront conversion embed.
  Reads the real Shopify cart and uses Shopify's recommendation endpoint to show
  one relevant next-product suggestion plus a configurable cart-value goal.
{% endcomment %}

<div
  id="cartlift-widget-root"
  data-cartlift="v1"
  data-goal="{{ block.settings.free_shipping_threshold | times: 100 }}"
  hidden
></div>

{% schema %}
{
  "name": "CartLift",
  "target": "body",
  "javascript": "cartlift-widget.js",
  "stylesheet": "cartlift.css",
  "settings": [
    {
      "type": "range",
      "id": "free_shipping_threshold",
      "label": "Free-shipping goal",
      "info": "Cart value in your store currency. Set to 0 to hide the goal.",
      "min": 0,
      "max": 5000,
      "step": 50,
      "default": 1000
    }
  ]
}
{% endschema %}
